.gradle/
build/
**/build/
*.iml
.idea/
/out/
# Hexagonal port packages are named "out"; never ignore source directories.
!**/src/**/out/

# Model lint dependencies (npm ci --prefix lint)
lint/node_modules/
# Camunda chart downloaded and rendered by scripts/ci/camunda-chart-render.sh
deploy/camunda-platform/.chart/
deploy/camunda-platform/rendered-*.yaml

# Staff web settings of a deployment (copied from config.example.json)
ui/bpo-staff-web/config.json

# Camunda Process Test coverage report
**/target/
